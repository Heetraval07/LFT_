{
  "name": "lft-interior-design",
  "version": "1.0.0",
  "description": "Website and admin dashboard for LFT Interior Design LLC, Dubai (Next.js, MariaDB, Prisma)",
  "scripts": {
    "dev": "next dev --port 5173",
    "build": "prisma generate && next build",
    "start": "next start --port ${PORT:-3000}",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.ts",
    "admin:create": "node scripts/create-admin.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "node scripts/interactions.mjs",
    "build:hostinger": "prisma generate && node scripts/deploy-tasks.ts && next build",
    "test:smtp": "node scripts/test-smtp.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.3.0",
    "bootstrap-icons": "^1.11.3",
    "playwright": "^1.48.2",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  },
  "private": true,
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "^16.4.4",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
