# Copy to .env for local development. In production, set these in Hostinger hPanel → your Node.js app →
# Environment variables. NEVER commit real values.

# ---- Database (MariaDB) ----
# mysql://USER:PASSWORD@HOST:3306/DATABASE   (on Hostinger the host is usually "localhost")
# If the password contains special characters (@ : / # ? &), URL-encode them (e.g. @ → %40).
DATABASE_URL="mysql://lft_user:change-me@localhost:3306/lft_database"

# ---- Contact form (SMTP via Nodemailer) ----
# Hostinger Email: smtp.hostinger.com, port 465, secure true. The sender is always SMTP_USER;
# the visitor's address is only used as Reply-To.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="website@yourdomain.com"
SMTP_PASSWORD=""
CONTACT_RECEIVER_EMAIL="info@lftinteriors.com"

# ---- Photo uploads (switched on only after the storage check in /admin passes) ----
# Absolute path OUTSIDE the app folder, e.g. /home/u123456789/lft-uploads
UPLOAD_DIR=""
UPLOADS_VERIFIED="false"

# ---- First deploy only — remove straight afterwards ----
# RUN_SEED="true"                      # loads the original 8 projects + 76 photos (skips existing ones)
# ADMIN_BOOTSTRAP_EMAIL="you@yourdomain.com"
# ADMIN_BOOTSTRAP_NAME="Your Name"
# ADMIN_BOOTSTRAP_PASSWORD="at-least-12-characters"
